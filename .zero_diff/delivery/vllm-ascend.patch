@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.5 MRoPE with the native trainer's BF16 intermediate boundaries."""
+
+import torch
+
+
+def training_mrope(query, key, positions, rotary_dim, base, mrope_section):
+    if positions.ndim == 1:
+        positions = positions.unsqueeze(0).expand(3, -1)
+    if positions.ndim != 2 or positions.shape[0] != 3:
+        raise ValueError("Qwen training MRoPE expects text or three-axis positions")
+    if query.dtype != torch.bfloat16 or key.dtype != query.dtype or rotary_dim % 2:
+        raise ValueError("Qwen training MRoPE requires BF16 and an even rotary dimension")
+    # Compute on the same device as the trainer, without a CPU-built trig cache.
+    inv_freq = 1.0 / (base ** (torch.arange(0, rotary_dim, 2, dtype=torch.float32, device=query.device) / rotary_dim))
+    freqs = positions.to(device=query.device, dtype=torch.float32).unsqueeze(-1) * inv_freq
+    selected = freqs[0].clone()
+    for axis, offset in enumerate((1, 2), start=1):
+        section = slice(offset, mrope_section[axis] * 3, 3)
+        selected[..., section] = freqs[axis, ..., section]
+    cos = selected.cos().to(query.dtype).repeat(1, 2).unsqueeze(1)
+    sin = selected.sin().to(query.dtype).repeat(1, 2).unsqueeze(1)
+
+    def apply(x):
+        rotated, passthrough = x[..., :rotary_dim], x[..., rotary_dim:]
+        left, right = rotated.chunk(2, dim=-1)
+        half = torch.cat((-right, left), dim=-1)
+        # Each multiply and the addition round to BF16, as in native MCore.
+        return torch.cat((rotated * cos + half * sin, passthrough), dim=-1)
+
+    return apply(query), apply(key)
diff --git a/vllm_ascend/ops/training_reduction.py b/vllm_ascend/ops/training_reduction.py
new file mode 100644
index 000000000..763441ef8
--- /dev/null
+++ b/vllm_ascend/ops/training_reduction.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fixed-order FP32 row reduction using the existing Ascend BI GEMM."""
+
+import torch
+import torch.nn.functional as F
+
+
+def fixed_vocab_sum(values: torch.Tensor, keepdim: bool = False) -> torch.Tensor:
+    """Sum each vocabulary row independently of the number of token rows.
+
+    Two fixed GEMM reductions avoid both CANN's batch-dependent reduction tree
+    and a long sequential FP32 accumulation over the entire vocabulary. This
+    primitive is shared with native Megatron CE via scoped operator dispatch;
+    native CE still owns its softmax, collectives, loss, and backward.
+    """
+    from vllm_ascend.ops.triton.batch_invariant.matmul import linear_persistent
+
+    if values.dtype != torch.float32 or values.device.type != "npu":
+        raise ValueError("fixed_vocab_sum requires an NPU FP32 tensor")
+    width = values.shape[-1]
+    if width == 0:
+        raise ValueError("fixed_vocab_sum requires a nonempty vocabulary")
+    tile = 1024
+    chunks = (width + tile - 1) // tile
+    flat = values.reshape(-1, width)
+    if flat.shape[0] == 0:
+        shape = (*values.shape[:-1], 1) if keepdim else values.shape[:-1]
+        return values.new_empty(shape)
+    padded = F.pad(flat, (0, chunks * tile - width))
+    partial = linear_persistent(
+        padded.reshape(-1, tile), values.new_ones((1, tile))
+    ).reshape(-1, chunks)
+    result = linear_persistent(partial, values.new_ones((1, chunks)))
+    shape = (*values.shape[:-1], 1) if keepdim else values.shape[:-1]
+    return result.reshape(shape)
